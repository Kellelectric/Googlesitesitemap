# PostgreSQL connection string. Local dev: run `docker run -p 5432:5432 ...`
# or use a hosted provider (Neon, Supabase, Railway) in production.
DATABASE_URL="postgresql://user:password@localhost:5432/kell_electricals"

# Random 32+ char secret used to sign the admin session cookie (HMAC).
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=""

# One-time production bootstrap token — set this, deploy, then call
# POST /api/admin/bootstrap with header "x-seed-token: <this value>" to
# create the service catalogue, engineers, default settings, and the first
# SUPER_ADMIN user on a freshly provisioned database (no shell access to a
# managed Postgres needed). Safe to call more than once. Generate with:
# openssl rand -hex 24. Consider unsetting it again after first use.
SEED_TOKEN=""

# Optional overrides for the admin user /api/admin/bootstrap creates.
# Defaults to kellelectricals@gmail.com / ChangeMe-KellAdmin-2026 if unset —
# change the password immediately after first login either way.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Directory (relative to project root) where uploaded assessment files are
# stored outside the public web root. Swap for S3/Cloudinary in production.
UPLOADS_DIR=".uploads"

# --- Optional integrations (app runs fine without these; see
# docs/assessment-platform-architecture.md section H) -----------------------

# Transactional email. If unset, emails are logged to the console/DB instead.
RESEND_API_KEY=""
EMAIL_FROM="Kell Electricals <no-reply@kellelectricals.com>"

# Internal notification recipient (new lead / emergency / high-value alerts).
INTERNAL_NOTIFICATION_EMAIL="info@kellelectricals.com"

# WhatsApp number used to build wa.me click-to-chat links (E.164, no plus).
NEXT_PUBLIC_WHATSAPP_NUMBER="2348140205895"

# Existing quote-form webhook (see src/app/api/quote/route.ts) — unrelated
# to the assessment platform but kept here for one env reference file.
QUOTE_WEBHOOK_URL=""

# Payment provider keys (payments architecture only — no live integration
# shipped in this pass; see src/lib/payments.ts).
PAYSTACK_SECRET_KEY=""
FLUTTERWAVE_SECRET_KEY=""
