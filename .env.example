# Copy to .env.local for local development, or set these in your
# deployment platform's environment variables for production.
# Nothing in this file is a real secret — both vars are optional and
# each feature no-ops safely when its var is unset.

# Quote form forwarding (src/app/api/quote/route.ts). Any URL that
# accepts a JSON POST works: a Zoho Flow webhook, Zapier, Make, etc.
# Without this set, quote submissions are validated and spam-filtered
# but not forwarded anywhere (the form shows a "not configured" message).
QUOTE_WEBHOOK_URL=

# GA4 measurement ID (src/components/analytics/GoogleAnalytics.tsx).
# Without this set, no analytics script renders at all.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
