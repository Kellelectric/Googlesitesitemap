# Copy to .env.local for local development, or set these in your
# deployment platform's environment variables (Vercel: Project Settings ->
# Environment Variables, set separately for Development/Preview/Production).
# Nothing in this file is a real secret - every value below is a variable
# NAME only. Every feature listed here no-ops safely when its var is unset,
# so the site keeps working during setup.

# --- Quote form (src/app/api/quote/route.ts) --------------------------

# Where validated quote submissions are forwarded (Zoho Flow, Zapier,
# Make, etc.). Without this, submissions are validated and spam-filtered
# but not forwarded anywhere.
QUOTE_WEBHOOK_URL=
# Optional. If set, each forwarded payload is signed with an
# x-webhook-signature header (HMAC-SHA256, hex-encoded) so the receiver
# can confirm the request genuinely came from this server.
QUOTE_WEBHOOK_SECRET=

# --- Careers application (src/app/api/careers-application/route.ts,
#     scripts/google-apps-script/) -------------------------------------
# See docs/careers-automation.md for the full pipeline design.

# Where validated career applications are forwarded - a Zoho Flow webhook,
# or directly a Google Apps Script Web App URL. Without this, the form
# shows a "not connected yet" message and nothing is lost (applicants are
# told to email/call directly).
CAREERS_WEBHOOK_URL=
# Optional but strongly recommended. Same HMAC-SHA256 signing scheme as
# QUOTE_WEBHOOK_SECRET - the Google Apps Script router verifies this same
# value, so it must match exactly on both sides.
CAREERS_WEBHOOK_SECRET=
# Optional. Comma-separated list of allowed Origin header values (e.g.
# https://kellelectricals.com,https://www.kellelectricals.com). Unset =
# no origin enforcement (current default behavior, unchanged).
CAREERS_ALLOWED_ORIGINS=

# --- Zoho CRM (src/lib/zohoCrm.ts) - shared by all 3 site forms --------
# Creates a Lead for every quote request, career application, and
# appointment booking, in the real "Leads" module already live in the
# client's org - one unified place every lead lands, independent of
# each form's own webhook/calendar integration and gated individually
# (a failure here never blocks or slows down the visitor's own
# submission). All four required together. See docs/careers-automation.md
# for the full setup steps (written when this only covered careers - the
# setup procedure is identical now that quote/booking use it too).
ZOHO_CRM_CLIENT_ID=
ZOHO_CRM_CLIENT_SECRET=
ZOHO_CRM_REFRESH_TOKEN=
# Data center domain suffix for the account, e.g. "com", "eu", "in",
# "com.au" - determines both accounts.zoho.<dc> and zohoapis.<dc>.
ZOHO_CRM_DC=

# --- Zoho Books: Contact + Estimate for every "Request a Quote" submission
#     only (src/lib/zohoBooks.ts) - NOT booking, NOT careers, per client
#     direction. Separate self-client credentials from Zoho CRM above (the
#     scope is different: ZohoBooks.fullaccess.all). All five required
#     together. Org confirmed live: 899637093 ("Kell Electricals Limited").
ZOHO_BOOKS_CLIENT_ID=
ZOHO_BOOKS_CLIENT_SECRET=
ZOHO_BOOKS_REFRESH_TOKEN=
ZOHO_BOOKS_DC=
ZOHO_BOOKS_ORGANIZATION_ID=

# --- Careers application: other direct integrations (src/lib/
#     slackNotify.ts, resendEmail.ts) - careers-only for now, optional,
#     independent of CAREERS_WEBHOOK_URL above, and gated individually.
#     See docs/careers-automation.md for full setup steps. ----------------

# Slack - posts a formatted message to an Incoming Webhook URL for every
# application.
CAREERS_SLACK_WEBHOOK_URL=

# Resend - sends an internal "new application" email (set alongside
# CAREERS_NOTIFY_EMAIL) and/or an applicant confirmation email (for
# job-openings/nysc-placement only - the 3 Google Form tracks get their
# "finish your application" email from the Apps Script webhook instead, if
# configured; see the duplicate-email note in careerApplicationRouter.gs).
RESEND_API_KEY=
# Verified sender address in Resend, e.g. careers@kellelectricals.com.
CAREERS_FROM_EMAIL=
# Internal recipient for the "new application" notification email. Without
# this, the internal notification email is skipped even if RESEND_API_KEY
# is set (the applicant confirmation email is independent of this var).
CAREERS_NOTIFY_EMAIL=

# --- Kell Assist chatbot free-text replies (src/app/api/chat/route.ts) -
# Guided quick-reply flows work with zero configuration. Free-text
# conversation additionally needs this set - runs on Groq's hosted Llama
# models. Get a key at https://console.groq.com/keys.

GROQ_API_KEY=
# Optional, defaults to openai/gpt-oss-120b (Groq's recommended
# migration target after deprecating Llama 3.3 70B - see
# https://console.groq.com/docs/deprecations for current model status).
GROQ_MODEL=

# --- Google Calendar booking (src/lib/googleCalendar.ts) ---------------
# See docs/next-steps.md's "On-site appointment booking" section for the
# full service-account setup procedure.

GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
# Optional, defaults to Africa/Lagos.
GOOGLE_CALENDAR_TIMEZONE=

# --- Paystack (booking payment gate, src/lib/paystack.ts) --------------

NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# --- Zoho SalesIQ chat widget (src/components/chat/ZohoSalesIQ.tsx) ----
# Inert (Botpress renders instead) until this is set - see
# docs/next-steps.md's Zoho SalesIQ section for why.

NEXT_PUBLIC_ZOHOSALESIQ_WIDGET_CODE=

# --- Analytics ------------------------------------------------------

# GA4 measurement ID (src/components/analytics/GoogleAnalytics.tsx).
# Without this set, no analytics script renders at all.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Sentry error tracking (src/instrumentation.ts, instrumentation-
#     client.ts, sentry.server.config.ts, sentry.edge.config.ts) --------
# sentry.io -> create a Next.js project -> Settings -> Client Keys (DSN).
# Same DSN value in both - one is server/edge, the other browser-side.
# Without these set, Sentry.init() disables itself and nothing changes.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional - only needed for next.config.js's source-map upload during
# build (readable stack traces in Sentry instead of minified code).
# sentry.io -> Settings -> Auth Tokens -> create one with project:releases
# scope. SENTRY_ORG/SENTRY_PROJECT are the org/project slugs from the
# project's URL.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Durable rate limiting + duplicate-submission guard (src/lib/kv.ts,
#     rateLimit.ts) -----------------------------------------------------
# Backs every write API route's rate limiter and the careers-application
# duplicate-submission guard with real Redis instead of an in-memory Map
# that resets on cold start and isn't shared across serverless instances.
# Without these set, both fall back to that original in-memory behavior -
# nothing breaks, it's just not durable across instances.
#
# Easiest setup: Vercel dashboard -> Storage -> Marketplace Database
# Providers -> "Upstash Redis"/"Redis" -> once connected to this project,
# Vercel sets its own KV_REST_API_URL/KV_REST_API_TOKEN pair instead of the
# two below - src/lib/kv.ts accepts either naming, so no need to duplicate
# values into these two as well.
# Manual setup instead: upstash.com -> create a Redis database -> REST API
# section has these two directly.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Google Business Profile live rating (src/lib/googleBusinessProfile.ts) -
# Replaces the hardcoded company.trust.googleRating/googleReviewCount in
# content/company.ts with a live reading, shown across the homepage, footer,
# and every services/projects/industries/service-area page. Without these
# set, every page keeps showing the static company.ts numbers unchanged.
#
# Unlike every other integration above, this one is NOT self-serve: Google
# only grants Business Profile API access after a manual review, and
# eligibility requires a Business Profile verified and active for 60+ days
# with a matching business website (see
# https://developers.google.com/my-business/content/prereqs). Request
# access, then create a Google Cloud project with the Business Information
# API enabled, an OAuth 2.0 client, and a refresh token authorized against
# the Business Profile that owns this location.
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REFRESH_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=

# --- WhatsApp internal lead notifications (src/lib/whatsapp.ts) --------
# Sends an internal WhatsApp message for every quote request, appointment
# booking, and career application - the same role Slack already plays for
# careers, on a channel this business's team plausibly already lives on.
# Independent of Slack/Resend/Zoho CRM; without these set, nothing changes.
#
# One external-approval step (same-day Meta review, not Google Business
# Profile's open-ended manual one): create a Meta app with the WhatsApp
# product, generate a permanent System User access token, and get ONE
# message template approved in WhatsApp Manager with exactly one body
# variable (e.g. "New lead from the website: {{1}}") - required because
# this is always a business-initiated message outside any 24-hour
# customer-conversation window. See src/lib/whatsapp.ts's header comment
# for the exact steps.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NOTIFY_TO=
WHATSAPP_TEMPLATE_NAME=
# Optional, defaults to "en_US" - must match the approved template's
# language exactly.
WHATSAPP_TEMPLATE_LANG=
